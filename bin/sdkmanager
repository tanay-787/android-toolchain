#!/usr/bin/env bash
# sdkmanager wrapper ensuring writable SDK root and proper JAVA_HOME
export JAVA_HOME="${JAVA_HOME:-/nix/store/5badkg3gmzg1c29akwglknkizfg6zj0g-openjdk-17.0.17+8}"
export ANDROID_HOME="${ANDROID_HOME:-/home/user/.androidsdkroot}"
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-/home/user/.androidsdkroot}"
export PATH="$JAVA_HOME/bin:$PATH"

exec "/home/user/.androidsdkroot/cmdline-tools/19.0/bin/.sdkmanager-wrapped_" --sdk_root="$ANDROID_HOME" "$@"
